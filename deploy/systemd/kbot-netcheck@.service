# kbot: the checks of the network isolation, run on the server by `kbot.ops.check`
# (02 §13.1, points 2 and 8; B19, point 35; E4-D04). An instance of this template runs
# `python -m kbot.ops.netcheck <case>` as the user given in the instance name, with the
# same isolation as the service of that user, so that what is checked is the real
# context: the Unix socket of PostgreSQL must work, KuCoin must be unreachable with
# IPAddressDeny=any, and the instance metadata must be rejected for every user but root
# and, from E4c, kbot_backup.
#
#   systemctl start kbot-netcheck@kbot_ingest   # exit 0 when every case holds
[Unit]
Description=kbot: network isolation check as %i

[Service]
Type=oneshot
User=%i
Group=%i
WorkingDirectory=/opt/kbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kbot/.venv/bin/python -m kbot.ops.netcheck
TimeoutStartSec=2min

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
