# kbot: B19 (point 35), checked on the server by `kbot.ops.netcheck b19` from inside the
# isolation of a service: with IPAddressDeny=any the Unix socket of PostgreSQL must still
# work for a user with a role, and KuCoin must be unreachable. An instance runs as the
# user given in its name:
#
#   systemctl start kbot-netcheck@kbot_ingest   # exit 0 when the case holds
#
# This unit blocks every address itself, so it says nothing about the metadata guard of
# E4-D04; that one is kbot-guardcheck@.service, which blocks nothing (review of E4a,
# E4a-04).
[Unit]
Description=kbot: B19 check (IPAddressDeny=any) as %i

[Service]
Type=oneshot
User=%i
Group=%i
WorkingDirectory=/opt/kbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kbot/.venv/bin/python -m kbot.ops.netcheck b19
TimeoutStartSec=2min

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
